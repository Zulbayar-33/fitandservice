<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="UTF-8">
  <title>Хоол Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: #f4f6f9;
      font-family: Arial, sans-serif;
    }

    .box {
      max-width: 900px;
      margin: 30px auto;
      background: white;
      padding: 25px;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .title {
      font-weight: 700;
      text-align: center;
      margin-bottom: 20px;
    }

    .table-wrap {
      overflow-x: auto;
    }
  </style>
</head>

<body>

<div class="container">
  <div class="box">

    <h3 class="title">Хоол бүртгэл Admin</h3>

    <a href="index.html" class="btn btn-secondary mb-3">
      Form руу буцах
    </a>

    <button class="btn btn-primary mb-3" onclick="loadData()">
      Refresh
    </button>

    <div id="msg"></div>

    <div class="table-wrap">
      <table class="table table-bordered table-striped">
        <thead>
          <tr>
            <th>Sheet</th>
            <th>Тайлбар</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>FitFood</td>
            <td>Fit food сонговол энд 1 орно</td>
          </tr>
          <tr>
            <td>ServiceFood</td>
            <td>Service хоол сонговол дүн орно</td>
          </tr>
          <tr>
            <td>A hool</td>
            <td>А хоол сонговол энд 1 орно</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</div>

<script>
const API_URL = "https://script.google.com/macros/s/AKfycbztuVTnZ1GlQAkwYWxOU01twBm9nZmsKEYsexvBbCY83uQrZkYimdc54AzhhoErjm96vA/exec";

async function loadData() {
  const msg = document.getElementById("msg");

  msg.innerHTML = "API шалгаж байна...";

  try {
    const res = await fetch(API_URL);
    const data = await res.json();

    if (data.success) {
      msg.innerHTML =
        "<div class='alert alert-success'>API ажиллаж байна. Ажилтан: " +
        (data.employees ? data.employees.length : 0) +
        "</div>";
    } else {
      msg.innerHTML =
        "<div class='alert alert-danger'>" +
        data.message +
        "</div>";
    }

  } catch (err) {
    console.log(err);
    msg.innerHTML =
      "<div class='alert alert-danger'>API холболт алдаа</div>";
  }
}

loadData();
</script>

</body>
</html>
